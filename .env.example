# Copy this file to .env and insert credentials only on your local machine.
TRAVELPAYOUTS_API_TOKEN=
TRAVELPAYOUTS_MARKER=
# Optional: live, segment-level offers. With this token TRO can show each flight,
# its connection airport, and scheduled layover instead of only a cached reference.
DUFFEL_ACCESS_TOKEN=
OTP_GTFS_URL=http://localhost:8080/otp/gtfs/v1
# Add only after Omio approves the project as a partner. Never expose these values to the frontend.
OMIO_API_KEY=
OMIO_API_URL=
# AeroDataBox schedule data through RapidAPI. Copy your private RapidAPI key into .env only.
AERODATABOX_RAPIDAPI_KEY=
# Development keeps diagnostics enabled. Set production on a deployed server
# to block cache-bypassing debug requests and internal registry diagnostics.
APP_ENV=development
# Browser origins allowed to call the backend, separated with commas.
CORS_ALLOWED_ORIGINS=http://localhost:5500
# Per-process safety limit for the provider-heavy POST /search endpoint.
SEARCH_RATE_LIMIT_PER_MINUTE=20
